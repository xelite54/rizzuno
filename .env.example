# Copy this file to .env.local and fill in real values there.
# .env.local is gitignored — never commit real secrets.

# Google OAuth client, from Google Cloud Console → APIs & Services →
# Credentials → OAuth client ID (Web application). See the app's own
# README/setup notes for the exact redirect URIs to register.
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Auth.js session-signing secret. Generate one with: npx auth secret
AUTH_SECRET=

# Production origin only — leave unset in local dev. Auth.js needs this to
# compute correct callback URLs when not running on Vercel's own domain.
# AUTH_URL=https://rizzuno.com

# Comma-separated Google account emails allowed to access /admin (the
# moderation console) and its report-resolution actions. Leave unset and
# nobody can access it.
ADMIN_EMAILS=

# Hosted Postgres connection string (Supabase or otherwise) — accounts,
# legal acceptance, blocks, reports, moderation actions. Shared by BOTH the
# Next.js app (Vercel) and the realtime server (Railway) — same value in
# both places, so a block/ban/report made through one is immediately visible
# to the other. No local-filesystem fallback exists; this is required.
DATABASE_URL=

# Signs the short-lived ticket that bridges an Auth.js session into the
# realtime WebSocket server (see lib/realtimeTicket.ts). Deliberately a
# separate secret from AUTH_SECRET — the realtime service needs this one
# and does NOT need AUTH_SECRET at all. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
REALTIME_TICKET_SECRET=

# Comma-separated Origin headers the realtime WebSocket server accepts
# connections from (e.g. https://rizzuno.com). Leave unset in local dev —
# defaults to allowing same-origin only. Required in production, where the
# frontend (Vercel) and the realtime server (Railway) are different hosts.
# ALLOWED_WS_ORIGINS=https://rizzuno.com

# Only needed on the Next.js app once the realtime/matchmaking server is
# deployed separately (Railway) — the browser connects its WebSocket there
# instead of to the page's own origin. Leave unset for same-host local dev.
# Include the realtime server's actual WebSocket path (server.ts only ever
# accepts upgrades on WS_PATH, "/rizzuno-ws" — see lib/signaling/protocol.ts)
# — a bare Railway origin with no path is normalized to this automatically
# by hooks/useSignalingSocket.ts, but set it explicitly here so the value
# you copy out of Railway's dashboard is unambiguous at a glance.
# NEXT_PUBLIC_WS_URL=wss://YOUR-RAILWAY-DOMAIN/rizzuno-ws

# Set automatically by Railway — the realtime server binds to this port.
# Leave unset in local dev; server.ts falls back to 3000.
# PORT=

# Optional TURN relay for WebRTC (see hooks/useWebRTC.ts) — without one,
# calls between two peers behind symmetric NATs or restrictive
# corporate/mobile-carrier firewalls can fail to connect at all; Google's
# public STUN servers alone can't help with those. Leave all three unset to
# stay STUN-only (fine for most home/office networks). Accepts one or
# several comma-separated URLs. These are NEXT_PUBLIC_* — readable in the
# shipped browser bundle, which is inherent to configuring
# RTCPeerConnection client-side; prefer a TURN provider with short-lived
# per-session credentials over a long-lived static secret for production.
# NEXT_PUBLIC_TURN_URL=turn:your-turn-host:3478,turns:your-turn-host:5349
# NEXT_PUBLIC_TURN_USERNAME=
# NEXT_PUBLIC_TURN_CREDENTIAL=

# Image moderation provider — Sightengine (see
# lib/imageModeration/sightengineProvider.ts). Every profile photo, post,
# and chat image goes through this before it can ever be persisted or
# forwarded to another user. Leave unset and the pipeline fails CLOSED by
# design: every real upload is rejected with "moderation_unavailable"
# rather than silently treated as safe. Get these from a Sightengine
# account (https://sightengine.com) — API user + API secret, found on your
# account's dashboard.
#
# REQUIRED IN BOTH of Rizzuno's separately-deployed processes — the
# Next.js app (Vercel) calls this from app/api/profile/me and
# app/api/profile/posts; the realtime server (Railway) calls it from
# server/ws-server.ts's "chat" image handler. Set the SAME values in both
# deployments' own environment configuration, the same way DATABASE_URL
# and REALTIME_TICKET_SECRET already must be.
# SIGHTENGINE_API_USER=
# SIGHTENGINE_API_SECRET=
