{
  "name": "rizzuno",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "tsx watch server.ts",
    "build": "next build",
    "start": "NODE_ENV=production tsx server.ts",
    "lint": "eslint",
    "test": "tsx --test --experimental-test-module-mocks tests/**/*.test.mts",
    "test:webrtc:browser": "tsx --experimental-test-module-mocks tests/browser/runMedia.mts",
    "test:cluster": "node --import tsx --experimental-test-module-mocks --test tests/integration/cluster.mts",
    "images:migrate": "tsx scripts/migrate-legacy-images.mts",
    "test:load": "node --import tsx --experimental-test-module-mocks tests/load/realtime.mts"
  },
  "dependencies": {
    "image-size": "2.0.4",
    "motion": "^13.1.0",
    "next": "16.3.5",
    "next-auth": "^5.0.0-beta.32",
    "pg": "^8.23.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "redis": "5.12.1",
    "sharp": "0.35.4",
    "stripe": "^22.6.1",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.8",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^26.6.1",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/ws": "^8.18.1",
    "eslint": "^9",
    "eslint-config-next": "16.3.5",
    "tailwindcss": "^4",
    "tsx": "^4.23.12",
    "typescript": "^5"
  }
}
